  "discord_chat": {
    "cases": [
      {
        "id": "legacy_without_optional_fields",
        "payload": {
          "type": "discord_chat",
          "username": "DiscordUser",
          "message": "hello"
        },
        "expected": {
          "username": "DiscordUser",
          "message": "hello",
          "discord_id": null
        },
        "server_payload": {
          "type": "discord_chat",
          "username": "DiscordUser",
          "message": "hello",
          "media_urls": []
        }
      },
      {
        "id": "nullable_identity_and_additive_media",
        "payload": {
          "type": "discord_chat",
          "username": "DiscordUser",
          "message": "hello",
          "discord_id": null,
          "media_urls": [
            "https://example.test/image.png"
          ]
        },
        "expected": {
          "username": "DiscordUser",
          "message": "hello",
          "discord_id": null
        },
        "server_payload": {
          "type": "discord_chat",
          "username": "DiscordUser",
          "message": "hello",
          "media_urls": [
            "https://example.test/image.png"
          ]
        }
      },
      {
        "id": "additive_sender_identity_and_unknown_field",
        "payload": {
          "type": "discord_chat",
          "username": "DiscordUser",
          "message": "hello",
          "discord_id": "123456789012345678",
          "future_metadata": {
            "revision": 2
          }
        },
        "expected": {
          "username": "DiscordUser",
          "message": "hello",
          "discord_id": "123456789012345678"
        },
        "server_payload": {
          "type": "discord_chat",
          "username": "DiscordUser",
          "message": "hello",
          "media_urls": []
        }
      }
    ]
  },
